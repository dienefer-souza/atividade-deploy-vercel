{
  "version": 2,
  "installCommand": "npm_config_build_from_source=true npm install",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "node_modules/sqlite3/**",
          "database.sqlite"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
